# TinaCMS — required for Tina Cloud / production editorial auth.
# Local `npm run dev:tina` works without these (filesystem mode).
# Get values from https://app.tina.io after connecting this GitHub repo.

NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Optional: override content branch (defaults to main / Vercel git ref)
# NEXT_PUBLIC_TINA_BRANCH=
# GITHUB_BRANCH=
